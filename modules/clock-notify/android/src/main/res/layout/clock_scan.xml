<?xml version="1.0" encoding="utf-8"?>
<!-- Shortcut widget: the whole card is one tap target that opens the camera tab. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scan_widget"
    style="@style/ClockCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/scan_badge"
        android:contentDescription="@string/clock_scan_action"
        android:padding="8dp"
        android:src="@drawable/ic_scan_qr" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/ClockScanTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clock_scan_title" />

        <TextView
            style="@style/ClockLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/clock_scan_caption" />
    </LinearLayout>
</LinearLayout>
